#!/usr/bin/env bash
# Regenerate Formula/runcrate.rb for a runcrate-cli release.
#
# Usage: bin/update-formula [vX.Y.Z]
# Without an argument it uses the latest published release of runcrateai/runcrate-cli.
# Checksums come from the release's own checksums.txt, so the formula always matches
# what `runcrate update` and the curl installer verify.
set -euo pipefail

REPO="runcrateai/runcrate-cli"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
FORMULA="$ROOT/Formula/runcrate.rb"

tag="${1:-}"
if [ -z "$tag" ]; then
  tag="$(curl -fsSL "https://api.github.com/repos/$REPO/releases/latest" \
    | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -n1)"
fi
[ -n "$tag" ] || { echo "could not resolve latest release tag" >&2; exit 1; }

sums="$(curl -fsSL "https://github.com/$REPO/releases/download/$tag/checksums.txt")"
sha() {
  local s
  s="$(printf '%s\n' "$sums" | awk -v f="$1" '$2 == f { print $1 }')"
  [ -n "$s" ] || { echo "no checksum for $1 in $tag" >&2; exit 1; }
  printf '%s' "$s"
}

base="https://github.com/$REPO/releases/download/$tag"

mkdir -p "$(dirname "$FORMULA")"
cat >"$FORMULA" <<EOF
# This file is generated by bin/update-formula. Do not edit by hand.
class Runcrate < Formula
  desc "Deploy and manage Runcrate GPU instances from your terminal"
  homepage "https://runcrate.ai"
  license "MIT"

  on_macos do
    on_arm do
      url "$base/runcrate-darwin-arm64"
      sha256 "$(sha runcrate-darwin-arm64)"
    end
    on_intel do
      url "$base/runcrate-darwin-amd64"
      sha256 "$(sha runcrate-darwin-amd64)"
    end
  end

  on_linux do
    on_arm do
      url "$base/runcrate-linux-arm64"
      sha256 "$(sha runcrate-linux-arm64)"
    end
    on_intel do
      url "$base/runcrate-linux-amd64"
      sha256 "$(sha runcrate-linux-amd64)"
    end
  end

  def install
    binary = Dir["runcrate-*"].first
    chmod 0755, binary
    bin.install binary => "runcrate"
    bin.install_symlink "runcrate" => "rc"
    generate_completions_from_executable(bin/"runcrate", "completion")
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/runcrate version")
  end
end
EOF

chmod 644 "$FORMULA"
echo "Formula/runcrate.rb -> $tag"
